{% liquid
  assign brand = section.settings.brand
  assign text = section.settings.text
  assign button_text = section.settings.button_text
  assign button_link = section.settings.button_link
%}

<header
  id="custom-header-{{ section.id }}"
  class="custom-header"
  style="
    --font: {{ section.settings.font.family }}, sans-serif;
    --bg: {{ section.settings.bg }};
    --text: {{ section.settings.text_color }};
    --btn-bg: {{ section.settings.btn_bg }};
    --btn-hover: {{ section.settings.btn_hover }};
  "
>
  <div class="custom-header__inner">

    <!-- Mobile menu -->
    <button
      class="custom-header__menu"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <i></i><i></i><i></i>
    </button>

    <!-- Logo -->
    <a
      class="custom-header__logo-wrap"
      href="{{ routes.root_url }}"
      aria-label="{{ brand }} home"
    >
      {% if section.settings.logo %}
        {{
          section.settings.logo
          | image_url: width: 808
          | image_tag:
            class: 'custom-header__logo',
            loading: 'eager',
            widths: '200,400,600,808',
            alt: section.settings.logo.alt | default: brand
        }}
      {% else %}
        <span>{{ brand }}</span>
      {% endif %}
    </a>

    <!-- Center text -->
    <p class="custom-header__text">{{ text }}</p>

    <!-- Desktop button -->
    <a
      class="custom-header__btn"
      href="{{ button_link | default: routes.all_products_collection_url }}"
    >
      <span>{{ button_text }}</span>
      <b aria-hidden="true">→</b>
    </a>

  </div>

  <!-- Mobile drawer -->
  <div class="custom-header__drawer" aria-hidden="true">

    <button
      class="custom-header__close"
      type="button"
      aria-label="Close menu"
    >
      ×
    </button>

    <p class="custom-header__drawer-text">
      {{ text }}
    </p>

    <a
      class="custom-header__drawer-btn"
      href="{{ button_link | default: routes.all_products_collection_url }}"
    >
      {{ button_text }}
      <span aria-hidden="true">→</span>
    </a>

  </div>

  <div class="custom-header__overlay"></div>
</header>


<style>
  #custom-header-{{ section.id }} {
    --scale: 1;
    width: 100%;
    height: 4.444vw;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    position: relative;
    z-index: 50;
  }

  #custom-header-{{ section.id }} .custom-header__inner {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    padding: 0 9.781vw;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
  }

  /* Logo */

  #custom-header-{{ section.id }} .custom-header__logo-wrap {
    width: 10.517vw;
    display: flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  #custom-header-{{ section.id }} .custom-header__logo {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Center text */

  #custom-header-{{ section.id }} .custom-header__text {
    margin: 0;
    text-align: center;
    font-size: 1.111vw;
    line-height: .932vw;
    font-weight: 400;
    letter-spacing: 0;
  }

  /* Button */

  #custom-header-{{ section.id }} .custom-header__btn {
    position: relative;
    isolation: isolate;
    overflow: hidden;

    width: 14.375vw;
    height: 3.056vw;
    box-sizing: border-box;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 1.2vw;

    background: var(--btn-bg);
    color: #000;

    text-decoration: none;
    text-transform: uppercase;

    font-size: 1.111vw;
    line-height: 1.422vw;
    font-weight: 400;
  }

  #custom-header-{{ section.id }} .custom-header__btn::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--btn-hover);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .45s cubic-bezier(.4,0,.2,1);
  }

  #custom-header-{{ section.id }} .custom-header__btn:hover::before {
    transform: scaleX(1);
  }

  #custom-header-{{ section.id }} .custom-header__btn span,
  #custom-header-{{ section.id }} .custom-header__btn b {
    position: relative;
    z-index: 1;
    transition: color .3s ease;
  }

  #custom-header-{{ section.id }} .custom-header__btn:hover {
    color: #fff;
  }

  #custom-header-{{ section.id }} .custom-header__btn b {
    font-size: 1.35vw;
    font-weight: 400;
    line-height: 1;
    transition: transform .3s ease;
  }

  #custom-header-{{ section.id }} .custom-header__btn:hover b {
    transform: translateX(.3vw);
  }

  /* Mobile menu button */

  #custom-header-{{ section.id }} .custom-header__menu {
    display: none;
  }

  /* Drawer */

  #custom-header-{{ section.id }} .custom-header__drawer,
  #custom-header-{{ section.id }} .custom-header__overlay {
    display: none;
  }


  /* ================= MOBILE ================= */

  @media (max-width: 749px) {

    #custom-header-{{ section.id }} {
      height: 40px;
    }

    #custom-header-{{ section.id }} .custom-header__inner {
      position: relative;
      display: flex;
      justify-content: center;
      padding: 0 12px;
    }

    /* Hamburger */

    #custom-header-{{ section.id }} .custom-header__menu {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);

      width: 20px;
      height: 20px;
      padding: 0;
      border: 0;
      background: none;

      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 3px;

      cursor: pointer;
    }

    #custom-header-{{ section.id }} .custom-header__menu i {
      display: block;
      width: 8px;
      height: 1px;
      background: currentColor;
    }

    /* Center logo */

    #custom-header-{{ section.id }} .custom-header__logo-wrap {
      width: 105px;
    }

    #custom-header-{{ section.id }} .custom-header__text,
    #custom-header-{{ section.id }} .custom-header__btn {
      display: none;
    }

    /* Drawer */

    #custom-header-{{ section.id }} .custom-header__drawer {
      display: block;

      position: fixed;
      inset: 0 auto 0 0;

      width: min(330px, 85vw);
      padding: 30px 24px;

      box-sizing: border-box;

      background: var(--bg);
      color: var(--text);

      transform: translateX(-100%);
      transition: transform .3s ease;

      z-index: 100;
    }

    #custom-header-{{ section.id }} .custom-header__drawer.is-open {
      transform: translateX(0);
    }

    /* Close */

    #custom-header-{{ section.id }} .custom-header__close {
      position: absolute;
      top: 15px;
      right: 18px;

      border: 0;
      background: none;

      font-family: Arial, sans-serif;
      font-size: 28px;
      font-weight: 300;

      cursor: pointer;
    }

    /* Drawer text */

    #custom-header-{{ section.id }} .custom-header__drawer-text {
      margin: 70px 0 35px;

      font-size: 18px;
      line-height: 1.3;
      font-weight: 400;
      text-align: center;
    }

    /* Drawer button */

    #custom-header-{{ section.id }} .custom-header__drawer-btn {
      width: 100%;
      min-height: 55px;

      padding: 0 18px;

      box-sizing: border-box;

      display: flex;
      align-items: center;
      justify-content: space-between;

      background: var(--btn-bg);
      color: #000;

      text-decoration: none;
      text-transform: uppercase;

      font-size: 14px;
      font-weight: 400;
    }

    /* Overlay */

    #custom-header-{{ section.id }} .custom-header__overlay {
      position: fixed;
      inset: 0;

      display: block;

      background: rgba(0,0,0,.35);

      opacity: 0;
      visibility: hidden;

      z-index: 90;

      transition: opacity .3s ease;
    }

    #custom-header-{{ section.id }} .custom-header__overlay.is-open {
      opacity: 1;
      visibility: visible;
    }

    body.custom-header-open {
      overflow: hidden;
    }
  }
</style>


<script>
(() => {
  const header = document.querySelector('#custom-header-{{ section.id }}');
  if (!header) return;

  const menu = header.querySelector('.custom-header__menu');
  const drawer = header.querySelector('.custom-header__drawer');
  const close = header.querySelector('.custom-header__close');
  const overlay = header.querySelector('.custom-header__overlay');

  const open = () => {
    drawer.classList.add('is-open');
    overlay.classList.add('is-open');
    drawer.setAttribute('aria-hidden', 'false');
    menu.setAttribute('aria-expanded', 'true');
    document.body.classList.add('custom-header-open');
  };

  const hide = () => {
    drawer.classList.remove('is-open');
    overlay.classList.remove('is-open');
    drawer.setAttribute('aria-hidden', 'true');
    menu.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('custom-header-open');
  };

  menu.addEventListener('click', open);
  close.addEventListener('click', hide);
  overlay.addEventListener('click', hide);

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') hide();
  });
})();
</script>


{% schema %}
{
  "name": "Custom header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "brand",
      "label": "Brand name",
      "default": "TISSO VISION"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Header text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Header background",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button background",
      "default": "#FFF544"
    },
    {
      "type": "color",
      "id": "btn_hover",
      "label": "Button hover background",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Custom header"
    }
  ]
}
{% endschema %}