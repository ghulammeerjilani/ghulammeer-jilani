<style>

@media screen and (min-width: 1025px) {
      .section-{{ section.id }}-padding {
          padding-top: {{ section.settings.padding_top }}px;
          padding-bottom: {{ section.settings.padding_bottom }}px;
      }
  }
  
  @media screen and (max-width: 1024px) {
      .section-{{ section.id }}-padding {
          padding-top: {{ section.settings.padding_top_tab }}px;
          padding-bottom: {{ section.settings.padding_bottom_tab }}px;
      }
  }
  
  @media screen and (max-width: 767px) {
      .section-{{ section.id }}-padding {
          padding-top: {{ section.settings.padding_top_mob }}px;
          padding-bottom: {{ section.settings.padding_bottom_mob }}px;
          padding-left: 0;
          padding-right: 0;
       }

  }
</style>


<div class=" {{ section.settings.custom-class }} section-{{ section.id }}-padding section-{{ section.id }}" style=" background-color:{{section.settings.bg_color}};">
    <div class="custom-product-slider page-width">
        <div class="section_title">
            <h2>{{ section.settings.heading }}</h2>
        </div>    

    
    </div>
</div>


{% schema %}
{
  "name": "Custom Product Slider",
  "settings": [
    { "type": "text", "id": "custom-class", "label": "Custom Class" },
    { "type": "color", "id": "bg_color", "label": "Background Color" },
    { "type": "header", "content": "Heading" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section Heading"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "View All"
    },
    { "type": "header", "content": "Padding Settings" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step":2, "unit": "px", "label": "Padding Top", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Padding Bottom", "default": 60 },
    { "type": "range", "id": "padding_top_tab", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Padding Top Tab", "default": 50 },
    { "type": "range", "id": "padding_bottom_tab", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Padding Bottom Tab", "default": 50 },
    { "type": "range", "id": "padding_top_mob", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Padding Top Mob", "default": 30 },
    { "type": "range", "id": "padding_bottom_mob", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Padding Bottom Mob", "default": 30 }
  ],
  "blocks": [
    {
      "type": "Product",
      "name": "Product",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Placeholder / Label",
          "default": "Field Name"
        },
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Slider"
    }
  ]
}
{% endschema %}

