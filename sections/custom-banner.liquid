<style>
#hero-{{ section.id }} .hero_banner_top img{
    width:100%;
}

</style>


<section class=" {{ section.settings.custom-class }}" id="hero-{{ section.id }}">
    <!-------------  Top Banner Image-------------- -->
    {% if section.settings.image_1 !=blank %}
        <div class="hero_banner_top">
            <img src="{{section.settings.image_1 | img_url:'master'}}">
        </div>
    {% endif %}

     <!------------- Image With text-------------- -->


</section>


{% schema %}
{
  "name": "Custom Hero Banner",
  "settings": [
    { 
        "type": "text",
        "id": "custom-class",
        "label": "Custom Class" 
    },
    { "type": "header", "content": "Hero Image" },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image-1",
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image-2",
    },
    { "type": "header", "content": "Content" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Link",
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
  ],
 
  "presets": [
    {
      "name": "Custom Hero Banner"
    }
  ]
}
{% endschema %}

