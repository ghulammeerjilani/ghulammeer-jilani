<style>


</style>


<div class=" {{ section.settings.custom-class }} section-{{ section.id }}-padding section-{{ section.id }}" style=" background-color:{{section.settings.bg_color}};">
    <div class="custom-product-slider page-width">
        <div class="section_title">
            <h2>{{ section.settings.heading }}</h2>
        </div>    

    
    </div>
</div>


{% schema %}
{
  "name": "Custom Hero Banner",
  "settings": [
    { "type": "text", "id": "custom-class", "label": "Custom Class" },
    { "type": "color", "id": "bg_color", "label": "Background Color" },
    { "type": "header", "content": "Heading" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section Heading"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "View All"
    },
    { "type": "header", "content": "Padding Settings" },
  ],
 
  "presets": [
    {
      "name": "Custom Hero Banner"
    }
  ]
}
{% endschema %}

