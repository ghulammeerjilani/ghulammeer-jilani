<style>


</style>


<div class=" {{ section.settings.custom-class }}">
    <div class="hero_banner page-width">
        <div class="section_title">
            <h2>{{ section.settings.heading }}</h2>
        </div>    

    
    </div>
</div>


{% schema %}
{
  "name": "Custom Hero Banner",
  "settings": [
    { 
        "type": "text",
        "id": "custom-class",
        "label": "Custom Class" 
    },
    { "type": "header", "content": "Heading" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section Heading"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "View All"
    },
  ],
 
  "presets": [
    {
      "name": "Custom Hero Banner"
    }
  ]
}
{% endschema %}

