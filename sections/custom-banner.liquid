<style>
#hero-{{ section.id }} .hero_banner_top img{
    width:100%;
}

#hero-{{ section.id }} .middle_row_wrapper{
    display: grid;
    grid-template-columns: 37% 63%;
    padding-left: 09.781vw;
}

#hero-{{ section.id }} .middle_row_wrapper .banner_image_wrapper img{
    width:100%;
}
/* ------  ------  */

#hero-{{ section.id }} .content_wrapper .heading{
font-weight: 500;
font-size: 70px;
line-height: 100%;
letter-spacing: 0px;

}

</style>


<section class=" {{ section.settings.custom-class }}" id="hero-{{ section.id }}">
    {% if section.settings.image_1 !=blank %}
        <div class="hero_banner_top">
            <img src="{{section.settings.image_1 | img_url:'master'}}">
        </div>
    {% endif %}

    <div class="middle_row_wrapper">

        <div class="content_wrapper">
            {%  if section.settings.heading !=blank %}
                <h2 class="heading"> {{ section.settings.heading }} </h2>
            {% endif %}

            {%  if section.settings.description !=blank %}
                <div class="description">{{ section.settings.description }}</div>
            {% endif %}
        </div>

         <div class="banner_image_wrapper">
             <img src="{{section.settings.image_2 | img_url:'master'}}">
        </div>
    </div>

</section>


{% schema %}
{
  "name": "Custom Hero Banner",
  "settings": [
    { 
        "type": "text",
        "id": "custom-class",
        "label": "Custom Class" 
    },
    { "type": "header", "content": "Hero Image" },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image-1",
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image-2",
    },
    { "type": "header", "content": "Content" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Link",
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
  ],
 
  "presets": [
    {
      "name": "Custom Hero Banner"
    }
  ]
}
{% endschema %}

