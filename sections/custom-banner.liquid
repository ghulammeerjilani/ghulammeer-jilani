
<style>
  #hero-{{ section.id }} {
    --heading-size: clamp(30px, 4.29vw, 100px);
    --desc-size: clamp(16px, 1.23vw, 24px);
    --bottom-size: clamp(12px, 1.11vw, 20px);
    --btn-bg: {{ section.settings.button_bg_color }};
    --btn-color: {{ section.settings.button_text_color }};
    --bottom-bg: {{ section.settings.bottom_bar_bg_color }};
    --bottom-color: {{ section.settings.bottom_bar_text_color }};
    overflow: hidden;
  }

  /* ---------- Top full-width image ---------- */
  #hero-{{ section.id }} .hero_banner_top {
    width: 100%;
    line-height: 0;
  }
  #hero-{{ section.id }} .hero_banner_top img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  /* ---------- Middle row: content + image ---------- */
  #hero-{{ section.id }} .middle_row_wrapper {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 2px 0 0 9.781vw;
    flex-wrap: wrap;
  }

  #hero-{{ section.id }} .content_wrapper {
    width: 32%;
    display: flex;
    flex-direction: column;
    gap: 50px;
  }

  #hero-{{ section.id }} .content_wrapper .heading {
    font-weight: 500;
    font-size: var(--heading-size);
    line-height: 100%;
    letter-spacing: 0px;
    margin: 0;
  }

  #hero-{{ section.id }} .content_wrapper .description {
    font-weight: 400;
    font-size: var(--desc-size);
    line-height: 140%;
    letter-spacing: 0px;
    margin: 0;
  }
  #hero-{{ section.id }} .content_wrapper .description p {
    margin: 0;
  }

  #hero-{{ section.id }} .content_wrapper .hero_btn {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 14.375vw;
    height: 3.056vw;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 1.2vw;
    background: var(--btn-bg);
    color: #fff;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 1.111vw;
    line-height: 1.422vw;
    font-weight: 400;
    gap: 1.20vw;
  }
  #hero-{{ section.id }} .content_wrapper .hero_btn:hover {
    color:#000000;
  }
  #hero-{{ section.id }} .content_wrapper .hero_btn svg {
    width:1.6667vw;
    flex-shrink: 0;
  }

  #hero-{{ section.id }} .content_wrapper .hero_btn::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:#FFF544;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .45s cubic-bezier(.4,0,.2,1);
  }

 #hero-{{ section.id }} .content_wrapper .hero_btn:hover::before {
    transform: scaleX(1);
  }


  #hero-{{ section.id }} .banner_image_wrapper {
    width: 68%;
    line-height: 0;
    flex:1;
  }
  #hero-{{ section.id }} .banner_image_wrapper img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  /* ---------- Bottom center bar ---------- */
  #hero-{{ section.id }} .bottom_bar {
    width: 100%;
    background: var(--bottom-bg);
    color: var(--bottom-color);
    text-align: center;
    vertical-align: middle;
    padding: 10px 20px;
  }
  #hero-{{ section.id }} .bottom_bar p {
    margin: 0;
    font-weight: 400;
    font-size: var(--bottom-size);
    line-height: 1.15;
    letter-spacing: 0px;
    text-transform: uppercase;
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 749px) {

    #hero-{{ section.id }} .hero_banner_top{
      display:none;
    }
    #hero-{{ section.id }} .middle_row_wrapper {
      padding: 0 0 0 0;
      gap: 24px;
      text-align: center;
    }

    #hero-{{ section.id }} .content_wrapper {
      width: 100%;
      align-items: center;
      gap: 24px;
      padding: 50px 12px 12px;
    }

    #hero-{{ section.id }} .content_wrapper .hero_btn svg{
    width:24px;
    
    }

    #hero-{{ section.id }} .banner_image_wrapper {
      width: 100%;
    }

    #hero-{{ section.id }}  .middle_row_wrapper{
      position:relative;
    }

    #hero-{{ section.id }} .content_wrapper .hero_btn{
      min-width: 193px;
      height: 45px;
      font-size: 16px;
      position: absolute;
      bottom: 40px;
    }
    
    #hero-{{ section.id }} .bottom_bar {
      padding: 12px 20px;
    }
  }
</style>

<section class="{{ section.settings.custom_class }}" id="hero-{{ section.id }}">

  {%- if section.settings.image_1 != blank -%}
    <div class="hero_banner_top">
      <img
        src="{{ section.settings.image_1 | img_url: 'master' }}"
        srcset="
          {{ section.settings.image_1 | img_url: '750x' }} 750w,
          {{ section.settings.image_1 | img_url: '1500x' }} 1500w,
          {{ section.settings.image_1 | img_url: '2000x' }} 2000w,
          {{ section.settings.image_1 | img_url: 'master' }} {{ section.settings.image_1.width }}w"
        sizes="100vw"
        alt="{{ section.settings.image_1.alt | default: section.settings.heading | escape }}"
        loading="lazy"
        width="{{ section.settings.image_1.width }}"
        height="{{ section.settings.image_1.height }}"
      >
    </div>
  {%- endif -%}

  <div class="middle_row_wrapper">

    <div class="content_wrapper">
      {%- if section.settings.heading != blank -%}
        <h2 class="heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="description">{{ section.settings.description }}</div>
      {%- endif -%}

      {%- if section.settings.button_text != blank -%}
        <a href="{{ section.settings.button_url | default: '#' }}" class="hero_btn">
          {{ section.settings.button_text }}
          <svg xmlns="http://www.w3.org/2000/svg" width="64" height="26" viewBox="0 0 64 26" fill="currentcolor">
          <path d="M1.76563 11.2357L9.72209e-05 11.2357L9.68518e-05 14.7667L1.76562 14.7667L1.76563 11.2357ZM63.0591 14.2496C63.7485 13.5602 63.7485 12.4423 63.0591 11.7528L51.8233 0.517056C51.1338 -0.172425 50.016 -0.172426 49.3265 0.517056C48.637 1.20654 48.637 2.32441 49.3265 3.01389L59.3138 13.0012L49.3265 22.9886C48.637 23.678 48.637 24.7959 49.3265 25.4854C50.016 26.1749 51.1338 26.1749 51.8233 25.4854L63.0591 14.2496ZM1.76562 14.7667L61.8106 14.7668L61.8106 11.2357L1.76563 11.2357L1.76562 14.7667Z" fill="currentcolor"/>
          </svg>
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.image_2 != blank -%}
      <div class="banner_image_wrapper">
        <img
          src="{{ section.settings.image_2 | img_url: 'master' }}"
          srcset="
            {{ section.settings.image_2 | img_url: '600x' }} 600w,
            {{ section.settings.image_2 | img_url: '1200x' }} 1200w,
            {{ section.settings.image_2 | img_url: 'master' }} {{ section.settings.image_2.width }}w"
          sizes="(max-width: 749px) 100vw, 45vw"
          alt="{{ section.settings.image_2.alt | escape }}"
          loading="lazy"
          width="{{ section.settings.image_2.width }}"
          height="{{ section.settings.image_2.height }}"
        >
      </div>
    {%- endif -%}

  </div>

  {%- if section.settings.bottom_text != blank -%}
    <div class="bottom_bar">
      <p>{{ section.settings.bottom_text }}</p>
    </div>
  {%- endif -%}

</section>

{% schema %}
{
  "name": "Custom Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom Class"
    },
    { "type": "header", "content": "Images" },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Top Image (full width)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Right Image (middle row)"
    },
    { "type": "header", "content": "Content" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    { "type": "header", "content": "Bottom Bar" },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom Bar Text",
      "default": "Sustainable, ethically made activewear"
    },
    {
      "type": "color",
      "id": "bottom_bar_bg_color",
      "label": "Bottom Bar Background",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "bottom_bar_text_color",
      "label": "Bottom Bar Text Color",
      "default": "#111111"
    }
  ],
  "presets": [
    {
      "name": "Custom Hero Banner"
    }
  ]
}
{% endschema %}
